# Install as /etc/paw/paw.env with mode 0600. Do not commit the real file.
PAW_TIME_ZONE=Australia/Sydney
PAW_DEV_PRINCIPAL_ISSUER=openai-secure-mcp-tunnel
PAW_DEV_PRINCIPAL_SUBJECT=replace-with-a-stable-private-subject
PAW_DEV_WORKSPACE_NAME=Personal AI Workspace
PAW_BACKUP_RETENTION_COUNT=14

# The base Compose file forces both runtime switches off. web-mode.sh selects
# the reviewed read or write overlay without editing this file.
PAW_WEB_ENABLED=false
PAW_WEB_WRITES_ENABLED=false
PAW_WEB_BOOTSTRAP_ENABLED=false
PAW_WEB_ORIGIN=https://workspace.example.com
PAW_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Optional two-mailbox checker. web-mode.sh read gmail enables its overlay.
# Select a Responses model supporting strict JSON schema after verifying key access.
# PAW_GMAIL_MODEL=your-verified-model-id
