PORT=3000
# Real data must stay outside the repository and OneDrive.
PAW_DB_PATH=%LOCALAPPDATA%\PersonalAIWorkspace\data\workspace.db
PAW_DEV_PRINCIPAL_ISSUER=dev-tunnel
PAW_DEV_PRINCIPAL_SUBJECT=local-user
PAW_DEV_WORKSPACE_NAME=Personal AI Workspace
# S1-01 local login boundary; disabled by default. No public ingress is configured.
PAW_WEB_ENABLED=false
PAW_WEB_WRITES_ENABLED=false
PAW_WEB_BOOTSTRAP_ENABLED=false
# PAW_WEB_ORIGIN=https://workspace.example.com
# PAW_WEB_PORT=3001
# PAW_GOOGLE_CLIENT_ID=<web-client-id>
# PAW_GOOGLE_CLIENT_SECRET_FILE=<absolute-private-file-outside-repository>
